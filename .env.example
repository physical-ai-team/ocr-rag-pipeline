# 복사해서 .env 로 저장하세요: cp .env.example .env  (Windows: copy)
# 이 파일은 커밋됩니다. 실제 키는 .env 에만 넣으세요.

# 03 OCR
OCR_ENGINE=easyocr        # easyocr | tesseract
USE_GPU=0
OCR_MIN_CONF=0.40

# 04 임베딩 / VectorDB
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SUPABASE_URL=https://<프로젝트ID>.supabase.co
SUPABASE_KEY=             # Project Settings → API → service_role 키
COLLECTION=ocr_chunks     # 테이블 이름 (sql/supabase_schema.sql 과 같게)
DEDUP_SIM=0.92
