# 복사해서 .env 로 저장하고 값을 채운다:  copy .env.example .env
# 이 파일은 커밋된다. 실제 키는 .env 에만 넣는다. (.env 는 .gitignore 에 있음)
# 키는 팀 채팅으로 따로 받는다. Git 에 올리지 말 것.

# ── RAG 답변 (Google AI Studio → Get API key) ───────────────
# 비워 두면 답변 없이 관련 문장만 보여 준다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── VectorDB (Supabase → Project Settings → API) ───────────
# 비워 두면 pipeline 이 메모리에 저장한다 (재시작하면 사라짐, 개발용)
SUPABASE_URL=
SUPABASE_KEY=
COLLECTION=ocr_chunks

# ── OCR / 임베딩 (기본값으로 충분) ─────────────────────────
OCR_ENGINE=easyocr
USE_GPU=0
OCR_MIN_CONF=0.40
# OCR_MAG_RATIO: 1.0 = 확대 안 함 (빠름), 1.5 = 짧은 단어를 덜 놓침 (CPU에서 약 1.5배 느림)
OCR_MAG_RATIO=1.5
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEDUP_SIM=0.92
